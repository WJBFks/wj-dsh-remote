{
  "name": "wj-dsh-remote",
  "version": "0.2.2",
  "private": false,
  "description": "Personal fork of @linxin666/dsh-remote-web-ui 0.4.14: scan-to-pair remote access for the DeepSeek Harness (dsh) web GUI, renamed to the wj-* namespace so it cannot collide with the upstream plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "adapters:sync": "node scripts/adapters-sync.mjs",
    "adapters:check": "node scripts/adapters-sync.mjs --check",
    "prepack": "node scripts/adapters-sync.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJBFks/wj-dsh-remote.git"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "cloudflared": "^0.7.3",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}